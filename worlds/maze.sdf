<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="maze_world">
    <!-- Physics configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic system plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Scene Lighting & Ambient -->
    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.82 0.88 0.95 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Default GUI Camera View focused on Start Area and Robot -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-4.5 -8.5 6.0 0 0.6 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <!-- Secondary fill light -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.4 0.4 0.45 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.5 -0.3 -0.8</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.24 0.27 1.0</ambient>
            <diffuse>0.35 0.38 0.42 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Start Marker (Green disc on ground) -->
    <model name="start_marker">
      <static>true</static>
      <pose>-4.5 -4.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.2 1.0</ambient>
            <diffuse>0.15 0.85 0.25 1.0</diffuse>
            <emissive>0.05 0.3 0.1 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Goal / Exit Marker (Gold disc on ground) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>4.5 4.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.65 0.1 1.0</ambient>
            <diffuse>0.95 0.75 0.15 1.0</diffuse>
            <emissive>0.3 0.25 0.05 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Entrance Gateway Pillars (Green) -->
    <model name="entrance_portal">
      <static>true</static>
      <link name="pillars">
        <!-- Left Pillar -->
        <visual name="pillar_left">
          <pose>-5.6 -6.0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.7 0.2 1</ambient>
            <diffuse>0.2 0.85 0.3 1</diffuse>
          </material>
        </visual>
        <!-- Right Pillar -->
        <visual name="pillar_right">
          <pose>-3.4 -6.0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.7 0.2 1</ambient>
            <diffuse>0.2 0.85 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Exit Gateway Pillars (Gold) -->
    <model name="exit_portal">
      <static>true</static>
      <link name="pillars">
        <!-- Left Pillar -->
        <visual name="pillar_left">
          <pose>3.4 6.0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.65 0.1 1</ambient>
            <diffuse>0.95 0.75 0.15 1</diffuse>
          </material>
        </visual>
        <!-- Right Pillar -->
        <visual name="pillar_right">
          <pose>5.6 6.0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.65 0.1 1</ambient>
            <diffuse>0.95 0.75 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Maze Structure Model -->
    <model name="maze">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="walls">

        <!-- ==================== PERIMETER WALLS (WITH OPEN ENTRANCE & EXIT) ==================== -->
        <!-- West Wall (Solid side boundary) -->
        <collision name="wall_west_col">
          <pose>-6.0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 12.15 1.0</size></box></geometry>
        </collision>
        <visual name="wall_west_vis">
          <pose>-6.0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 12.15 1.0</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.55 1.0</ambient>
            <diffuse>0.22 0.48 0.72 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>

        <!-- East Wall (Solid side boundary) -->
        <collision name="wall_east_col">
          <pose>6.0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 12.15 1.0</size></box></geometry>
        </collision>
        <visual name="wall_east_vis">
          <pose>6.0 0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 12.15 1.0</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.55 1.0</ambient>
            <diffuse>0.22 0.48 0.72 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>

        <!-- South Wall - Left Corner (x: -6.0 to -5.5 -> length 0.5m) -->
        <collision name="wall_south_left_col">
          <pose>-5.8 0 -6.0 0 0 0</pose>
          <pose>-5.8 -6.0 0.5 0 0 0</pose>
          <geometry><box><size>0.55 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="wall_south_left_vis">
          <pose>-5.8 -6.0 0.5 0 0 0</pose>
          <geometry><box><size>0.55 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.55 1.0</ambient>
            <diffuse>0.22 0.48 0.72 1.0</diffuse>
          </material>
        </visual>

        <!-- [OPENING: South Entrance Gate between x=-5.5 and x=-3.5 (2.0m wide)] -->

        <!-- South Wall - Main Segment (x: -3.5 to 6.0 -> length 9.5m) -->
        <collision name="wall_south_main_col">
          <pose>1.25 -6.0 0.5 0 0 0</pose>
          <geometry><box><size>9.6 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="wall_south_main_vis">
          <pose>1.25 -6.0 0.5 0 0 0</pose>
          <geometry><box><size>9.6 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.55 1.0</ambient>
            <diffuse>0.22 0.48 0.72 1.0</diffuse>
          </material>
        </visual>

        <!-- North Wall - Main Segment (x: -6.0 to 3.5 -> length 9.5m) -->
        <collision name="wall_north_main_col">
          <pose>-1.25 6.0 0.5 0 0 0</pose>
          <geometry><box><size>9.6 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="wall_north_main_vis">
          <pose>-1.25 6.0 0.5 0 0 0</pose>
          <geometry><box><size>9.6 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.55 1.0</ambient>
            <diffuse>0.22 0.48 0.72 1.0</diffuse>
          </material>
        </visual>

        <!-- [OPENING: North Exit Gate between x=3.5 and x=5.5 (2.0m wide)] -->

        <!-- North Wall - Right Corner (x: 5.5 to 6.0 -> length 0.5m) -->
        <collision name="wall_north_right_col">
          <pose>5.8 6.0 0.5 0 0 0</pose>
          <geometry><box><size>0.55 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="wall_north_right_vis">
          <pose>5.8 6.0 0.5 0 0 0</pose>
          <geometry><box><size>0.55 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.15 0.35 0.55 1.0</ambient>
            <diffuse>0.22 0.48 0.72 1.0</diffuse>
          </material>
        </visual>

        <!-- ==================== WIDE & NAVIGABLE INTERIOR WALLS ==================== -->
        <!-- Wall I1: Vertical West spine at x=-3.0 (from y=-6.0 to y=1.5, length 7.5m) -->
        <!-- Leaves wide 2.85m corridor on the west -->
        <collision name="wall_i1_col">
          <pose>-3.0 -2.25 0.5 0 0 0</pose>
          <geometry><box><size>0.15 7.5 1.0</size></box></geometry>
        </collision>
        <visual name="wall_i1_vis">
          <pose>-3.0 -2.25 0.5 0 0 0</pose>
          <geometry><box><size>0.15 7.5 1.0</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.65 1.0</ambient>
            <diffuse>0.35 0.6 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Wall I2: Horizontal top baffle at y=3.5 (from x=-3.0 to x=0.5, length 3.5m) -->
        <!-- Creates a top passage with 2.5m clearance to North wall -->
        <collision name="wall_i2_col">
          <pose>-1.25 3.5 0.5 0 0 0</pose>
          <geometry><box><size>3.6 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="wall_i2_vis">
          <pose>-1.25 3.5 0.5 0 0 0</pose>
          <geometry><box><size>3.6 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.65 1.0</ambient>
            <diffuse>0.35 0.6 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Wall I3: Central vertical spine at x=-0.5 (from y=-4.0 to y=1.5, length 5.5m) -->
        <collision name="wall_i3_col">
          <pose>-0.5 -1.25 0.5 0 0 0</pose>
          <geometry><box><size>0.15 5.5 1.0</size></box></geometry>
        </collision>
        <visual name="wall_i3_vis">
          <pose>-0.5 -1.25 0.5 0 0 0</pose>
          <geometry><box><size>0.15 5.5 1.0</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.65 1.0</ambient>
            <diffuse>0.35 0.6 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Wall I4: Horizontal bottom divider at y=-3.8 (from x=-0.5 to x=2.5, length 3.0m) -->
        <!-- Leaves 2.2m clearance to South wall -->
        <collision name="wall_i4_col">
          <pose>1.0 -3.8 0.5 0 0 0</pose>
          <geometry><box><size>3.0 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="wall_i4_vis">
          <pose>1.0 -3.8 0.5 0 0 0</pose>
          <geometry><box><size>3.0 0.15 1.0</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.65 1.0</ambient>
            <diffuse>0.35 0.6 0.85 1.0</diffuse>
          </material>
        </visual>

        <!-- Wall I5: East vertical baffle at x=2.5 (from y=-1.5 to y=3.5, length 5.0m) -->
        <!-- Leaves wide 3.5m passage straight to exit on East side -->
        <collision name="wall_i5_col">
          <pose>2.5 1.0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 5.0 1.0</size></box></geometry>
        </collision>
        <visual name="wall_i5_vis">
          <pose>2.5 1.0 0.5 0 0 0</pose>
          <geometry><box><size>0.15 5.0 1.0</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.65 1.0</ambient>
            <diffuse>0.35 0.6 0.85 1.0</diffuse>
          </material>
        </visual>

      </link>
    </model>
  </world>
</sdf>
